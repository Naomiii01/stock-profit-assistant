# ============================================================================
# Stock Profit Assistant - 環境變數範例
# 複製這個檔案為 .env.local，並填入你自己的金鑰
# ============================================================================

# --- Supabase（必填）---
# 到 Supabase 專案 -> Project Settings -> API 取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service role key 僅供未來後端排程（如每日備份、股價更新）使用，切勿外流或放進前端程式碼
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI 功能（選填，未設定時 AI截圖辨識 / AI投資教練 會使用示範資料）---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- 即時股價（選填，未設定時持股管理需手動輸入現價）---
# 例如可串接台灣證交所 OpenAPI、Finmind、或其他股價資料商
STOCK_PRICE_API_KEY=
